#!/usr/bin/make -f
include /usr/share/dpkg/pkg-info.mk

# Pinned NVIDIA inputs, fetched beforehand with `make inputs`; the build
# itself never touches the network.
TURING_UNLOCK_INPUTS ?= $(HOME)/.cache/turing-unlock/inputs
ASSETS := $(CURDIR)/debian/turing-unlock-build/assets

%:
	dh $@

override_dh_auto_configure:
	test "$$(cat VERSION)" = "$(DEB_VERSION_UPSTREAM)"

override_dh_auto_build:
	$(MAKE) INPUTS="$(TURING_UNLOCK_INPUTS)" ASSETS="$(ASSETS)" firmware

override_dh_auto_install:
	$(MAKE) DESTDIR=$(CURDIR)/debian/tmp ASSETS="$(ASSETS)" \
		install-dkms install-firmware install-initramfs-tools install-dracut
